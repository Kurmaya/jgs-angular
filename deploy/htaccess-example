# public_html/.htaccess for www.jgschool.in (Hostinger), updated for the prerendered home page.
# Based on the file currently on the server. Changes are marked "CHANGED" or "NEW".
# The blog's own .htaccess (public_html/blog/.htaccess, standard WordPress) needs no changes.

# NEW: "/" must serve index.html (the prerendered home page), even if an index.php is ever added here.
# FIXED (1 Nov 2026): this setting also applies to every sub-folder, so it must list index.php too.
# With index.html alone, /blog/ (WordPress) and /gallery/ (PHP) returned "403 Forbidden".
DirectoryIndex index.html index.php

# NEW (JGS Difference release): prerendered pages live in folders (jgsdifference/index.html).
# Without this, Apache would redirect /jgsdifference to /jgsdifference/ before serving it.
DirectorySlash Off

# NEW: make browsers check for a new version of the HTML pages on every visit, so parents
# see a new release straight away instead of a cached old page. The JS/CSS files have
# version hashes in their names (main.<hash>.js), so they can still be cached for a long time.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.[0-9a-f]{16}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect non-www to www
    # CHANGED: 302 -> 301, so search engines treat www.jgschool.in as the one address (brief item S2).
    RewriteCond %{HTTP_HOST} ^jgschool\.in$ [NC]
    RewriteRule ^ https://www.jgschool.in%{REQUEST_URI} [R=301,L]

    # Redirect HTTP to HTTPS
    # CHANGED: 302 -> 301
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://www.jgschool.in%{REQUEST_URI} [R=301,L]

    # FIXED (1 Nov 2026): with DirectorySlash Off, /blog and /gallery need their trailing slash added here.
    RewriteRule ^(blog|gallery)$ https://www.jgschool.in/$1/ [R=301,L,NC]

    # Preserve PHP gallery
    RewriteRule ^gallery(/|$) - [L,NC]

    # Preserve WordPress blog
    RewriteRule ^blog(/|$) - [L,NC]

    # Explicitly handle Angular contact route
    # CHANGED: index.html -> index.original.html (see the note on the fallback below)
    RewriteRule ^contact/?$ /index.original.html [L,NC]

    # NEW (JGS Difference release): serve prerendered pages, e.g. /jgsdifference -> /jgsdifference/index.html,
    # so search engines and AI assistants get the page's full text. Add more pages to the
    # "prerender" routes in angular.json and they are picked up here automatically.
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.+?)/?$ /$1/index.html [L]

    # Serve existing files and directories ("/" gets index.html, the prerendered home page)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Angular fallback for every other page (/about, /home, /facilities, ...)
    # CHANGED: index.html -> index.original.html.
    # After `ng run eduman:prerender`, index.html contains the home page's text and canonical link.
    # index.original.html is the plain app shell. Serving index.html here would show the home page's
    # content and canonical to search engines on every other URL.
    RewriteRule ^ /index.original.html [L]
</IfModule>
