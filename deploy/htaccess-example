# Example Apache rules for jgschool.in (GoDaddy hosting) after the prerendering change.
# MERGE these with the .htaccess already on the server; do not overwrite rules you still need.

RewriteEngine On

# One host: https://www.jgschool.in (brief item S2)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.jgschool.in%{REQUEST_URI} [L,R=301]

# Serve real files and folders as they are. "/" is a folder, so it gets index.html,
# which is now the prerendered home page with all its text.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Every other page (/about, /contact, /home, ...) gets the plain app shell.
# IMPORTANT: point this at index.original.html, NOT index.html. If other URLs received
# index.html, search engines would see the home page's text and canonical link on every page.
RewriteRule ^ /index.original.html [L]
