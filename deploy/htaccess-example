# public_html/.htaccess for www.jgschool.in (Hostinger), updated for the prerendered home page.
# Based on the file currently on the server. Changes are marked "CHANGED" or "NEW".
# The blog's own .htaccess (public_html/blog/.htaccess, standard WordPress) needs no changes.

# NEW: "/" must serve index.html (the prerendered home page), even if an index.php is ever added here.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect non-www to www
    # CHANGED: 302 -> 301, so search engines treat www.jgschool.in as the one address (brief item S2).
    RewriteCond %{HTTP_HOST} ^jgschool\.in$ [NC]
    RewriteRule ^ https://www.jgschool.in%{REQUEST_URI} [R=301,L]

    # Redirect HTTP to HTTPS
    # CHANGED: 302 -> 301
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://www.jgschool.in%{REQUEST_URI} [R=301,L]

    # Preserve PHP gallery
    RewriteRule ^gallery(/|$) - [L,NC]

    # Preserve WordPress blog
    RewriteRule ^blog(/|$) - [L,NC]

    # Explicitly handle Angular contact route
    # CHANGED: index.html -> index.original.html (see the note on the fallback below)
    RewriteRule ^contact/?$ /index.original.html [L,NC]

    # Serve existing files and directories ("/" gets index.html, the prerendered home page)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Angular fallback for every other page (/about, /home, /facilities, ...)
    # CHANGED: index.html -> index.original.html.
    # After `ng run eduman:prerender`, index.html contains the home page's text and canonical link.
    # index.original.html is the plain app shell. Serving index.html here would show the home page's
    # content and canonical to search engines on every other URL.
    RewriteRule ^ /index.original.html [L]
</IfModule>
